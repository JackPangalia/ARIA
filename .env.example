# Copy to .env.local and fill in values, then restart `npm run dev`.

# --- Anthropic (server; REQUIRED — every model call runs on Anthropic) ---
# Live answers, web search, and background summaries. The server refuses to
# boot without this.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Cartesia TTS (server) ---
# https://play.cartesia.ai/
CARTESIA_API_KEY=
CARTESIA_MODEL_ID=sonic-3.6
# Fallback voice for users who haven't picked one. Keep in sync with the first
# entry of KIVO_VOICES in src/lib/audio/voices.ts (currently Alfie, British male).
CARTESIA_VOICE_ID=5e7d492a-5502-482e-b315-ebf587427806

# --- Speechmatics (server) ---
# https://portal.speechmatics.com/
SPEECHMATICS_API_KEY=

# --- Composio (server; post-beta — parked, see docs/connectors.md) ---
# https://app.composio.dev/developers
COMPOSIO_API_KEY=

# --- Recall.ai meeting-bot mode (V2 only — leave unset for V1) ---
# https://www.recall.ai/  → Dashboard → API Keys
# Also set MEETING_BOT_ENABLED=true in src/lib/features.ts when ready to ship.
RECALL_API_KEY=
# Recall region host, e.g. us-east-1, us-west-2, eu-central-1 (see Recall dashboard)
RECALL_REGION=us-east-1
# Shared secret to verify inbound Recall webhooks
RECALL_WEBHOOK_SECRET=
# Public URL of the always-on bot worker (Railway), handed to Recall as the real-time target
# BOT_WORKER_PUBLIC_URL=https://your-worker.up.railway.app
# Recall streaming-ASR: "low_latency" (default) — fast join + transcripts.
# Wake word is handled in software (fuzzy "Kivo" on partials). Set "accuracy"
# only if you accept much slower bot startup and transcripts (enables key_terms).
# RECALL_TRANSCRIPT_MODE=low_latency

# --- Firebase Admin (server; keep private) ---
# Option A: paste the full service account JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual fields from the service account JSON
# FIREBASE_PROJECT_ID=aria-moserun-0512
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# --- Stripe Billing (server; optional — billing routes return 503 without these) ---
# https://dashboard.stripe.com/test/apikeys
# Prefer a restricted key (rk_...) with Checkout + Billing + Customers permissions.
STRIPE_SECRET_KEY=
# From Stripe Dashboard → Developers → Webhooks → your endpoint signing secret
STRIPE_WEBHOOK_SECRET=
# Monthly recurring Price IDs for paid tiers (test or live mode must match the API key)
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
# Public app URL for Checkout/Portal return redirects (no trailing slash)
APP_URL=http://localhost:3000

# --- Public site URL (client + metadata) ---
# Canonical site origin for SEO metadata/sitemap/OG tags. In production this is
# the same value as APP_URL (they exist separately because APP_URL is server-only).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vercel Cron (server) ---
# Random secret; Vercel sends it as "Authorization: Bearer <CRON_SECRET>" on
# cron invocations (retention purge at /api/cron/retention).
CRON_SECRET=

# Dev logging (optional; ask pipeline timing logs run automatically in NODE_ENV=development)
# ARIA_CONTEXT_DEBUG=1      — same pipeline logs when not in dev mode
# ARIA_CONTEXT_VERBOSE=1    — dump full prompts/summaries to terminal
# ARIA_DEV_VERBOSE=1        — log every STT utterance line (very noisy)

# --- Firebase (client; NEXT_PUBLIC_* are exposed to the browser) ---
# Firebase Console → Project settings → Your apps → Web app → SDK setup
# Project in .firebaserc: aria-moserun-0512
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aria-moserun-0512.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aria-moserun-0512
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aria-moserun-0512.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
