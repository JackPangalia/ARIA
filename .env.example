# Copy to .env.local and fill in values, then restart `npm run dev`.

# --- OpenAI (server) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# --- Deepgram (server) ---
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# --- AssemblyAI (legacy; no longer used for live diarization) ---
# ASSEMBLYAI_API_KEY=

# --- Firebase Admin (server; keep private) ---
# Option A: paste the full service account JSON on one line
# FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: individual fields from the service account JSON
# FIREBASE_PROJECT_ID=aria-moserun-0512
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Optional separate model for session summarization
# OPENAI_SUMMARY_MODEL=gpt-5.4-mini

# --- Firebase (client; NEXT_PUBLIC_* are exposed to the browser) ---
# Firebase Console → Project settings → Your apps → Web app → SDK setup
# Project in .firebaserc: aria-moserun-0512
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aria-moserun-0512.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aria-moserun-0512
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aria-moserun-0512.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
